# NanoClaw v2 — env template
# Copy the lines you need into `.env`. Channels are gated by their own vars,
# so unset/empty values mean "channel disabled".

# --- http channel (local injection endpoint) -------------------------------
# Bearer-authed HTTP listener for cron jobs / CLI tools / scripts to inject
# messages without holding a real chat-platform identity. Replies are routed
# to the channel named in `reply_to_group` on each POST, not back to HTTP.
#
# NANOCLAW_HTTP_TOKEN must be set to enable the channel; without it the
# adapter stays inactive and no port is opened.
NANOCLAW_HTTP_PORT=8787
NANOCLAW_HTTP_TOKEN=
