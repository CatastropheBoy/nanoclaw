# NanoClaw v2 — env template
# Copy the lines you need into `.env`. Channels are gated by their own vars,
# so unset/empty values mean "channel disabled".

# --- http channel (local injection endpoint) -------------------------------
# Bearer-authed HTTP listener for cron jobs / CLI tools / scripts to inject
# messages without holding a real chat-platform identity. Replies are routed
# to the channel named in `reply_to_group` on each POST, not back to HTTP.
#
# NANOCLAW_HTTP_TOKEN must be set to enable the channel; without it the
# adapter stays inactive and no port is opened.
NANOCLAW_HTTP_PORT=8787
NANOCLAW_HTTP_TOKEN=

# Bind address. Default 127.0.0.1 (loopback only). Set to 0.0.0.0 to expose
# on every interface — only do this on trusted networks; the bearer token is
# the sole access control.
NANOCLAW_HTTP_BIND=127.0.0.1

# --- /transcribe (POST WAV → faster-whisper → /message routing) -----------
# Upstream OpenAI-compatible transcription endpoint. Default points at a
# local `fedirz/faster-whisper-server` container on port 8786. Set empty to
# disable /transcribe (returns 503). The /message endpoint is unaffected.
NANOCLAW_TRANSCRIBE_URL=http://127.0.0.1:8786/v1/audio/transcriptions
NANOCLAW_TRANSCRIBE_MODEL=Systran/faster-distil-whisper-large-v3
